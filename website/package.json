{
  "name": "ejm-ide-website",
  "private": true,
  "type": "module",
  "description": "ide.ejmlabs.com, built on ejm-ui",
  "scripts": {
    "dev": "ejm-ssg dev",
    "build": "ejm-ssg build && ejm-site-headers dist/_headers --check",
    "typecheck": "tsc -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "@ejm/core": "file:../../ejm-ui/packages/core",
    "@ejm/demos": "file:../../ejm-ui/packages/demos",
    "@ejm/site": "file:../../ejm-ui/packages/site",
    "@ejm/ssg": "file:../../ejm-ui/packages/ssg",
    "@ejm/tokens": "file:../../ejm-ui/packages/tokens",
    "@ejm/ui": "file:../../ejm-ui/packages/ui",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.0"
  }
}
