{
  "name": "@ejmlabs/ide-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ide.ejmlabs.com: the ejm-ide download site, a prerendered Vite and React site on ejm-ui.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "ejm-ssg dev",
    "build": "ejm-ssg build",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && ejm-site-headers dist/_headers --check && npm test"
  },
  "dependencies": {
    "@ejm/core": "file:../../ejm-ui/packages/core",
    "@ejm/demos": "file:../../ejm-ui/packages/demos",
    "@ejm/site": "file:../../ejm-ui/packages/site",
    "@ejm/ssg": "file:../../ejm-ui/packages/ssg",
    "@ejm/tokens": "file:../../ejm-ui/packages/tokens",
    "@ejm/ui": "file:../../ejm-ui/packages/ui",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "parse5": "8.0.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
