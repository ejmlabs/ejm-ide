{
  "name": "ejm-ide",
  "private": true,
  "version": "0.1.0",
  "description": "A desktop coding IDE with Edi, built on the shared ejm-harness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ejmlabs/ejm-ide.git"
  },
  "homepage": "https://ide.ejmlabs.com",
  "bugs": {
    "url": "https://github.com/ejmlabs/ejm-ide/issues"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1421",
    "tauri": "tauri",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "lint": "biome check --formatter-enabled=false --error-on-warnings .",
    "lint:fix": "biome check --write --formatter-enabled=false --error-on-warnings .",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings",
    "format": "biome format --write . && cargo fmt --manifest-path src-tauri/Cargo.toml --package ejm-ide",
    "format:check": "biome format . && cargo fmt --manifest-path src-tauri/Cargo.toml --package ejm-ide -- --check",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --all-targets --locked",
    "verify": "npm run format:check && npm run lint && npm run check && npm test && npm run lint:rust && npm run test:rust && npm run build",
    "dev:desktop": "tauri dev --no-watch",
    "site:install": "npm --prefix website ci --ignore-scripts",
    "site:dev": "npm --prefix website run dev",
    "site:build": "npm run site:install && npm --prefix website run build",
    "site:check": "npm run site:install && npm --prefix website run check && tsc -p distribution/tsconfig.json --noEmit",
    "site:preview": "wrangler dev --config distribution/wrangler.jsonc --ip 127.0.0.1 --port 1423",
    "site:deploy": "npm run site:build && npm run site:check && npm test && wrangler deploy --config distribution/wrangler.jsonc"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@monaco-editor/react": "4.7.0",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@shikijs/monaco": "4.5.0",
    "@tauri-apps/api": "2.12.4",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "diff": "9.0.0",
    "lucide-react": "^0.577.0",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "4.14.6",
    "recharts": "3.10.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-preset-lint-recommended": "^7.0.1",
    "remark-stringify": "^11.0.0",
    "shiki": "4.5.0",
    "tailwind-merge": "^3.5.0",
    "unified": "^11.0.5",
    "vscode-css-languageservice": "6.3.10",
    "vscode-html-languageservice": "5.6.2",
    "vscode-json-languageservice": "5.7.2",
    "vscode-languageserver-textdocument": "1.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "^0.28.2",
    "pyright": "^1.1.408",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-language-server": "^6.0.2",
    "vite": "8.3.4",
    "vitest": "^5.0.5",
    "vscode-languageserver-protocol": "3.18.4",
    "wrangler": "4.153.0"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.17"
    }
  }
}
