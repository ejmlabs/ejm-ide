{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/target",
      "!!**/.workbench",
      "!!.impeccable/build",
      "!!src-tauri/gen",
      "!!src-tauri/permissions/autogenerated",
      "!!.github/review-context",
      "!!review/dependency-sources",
      "!**/*.tsbuildinfo",
      "!!distribution/worker-configuration.d.ts",
      "!!website/public/design-kit",
      "!!app/theme.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["website/*.html", "website/public/*.html"],
      "linter": {
        "rules": {
          "a11y": {
            "useAnchorContent": "off",
            "useSemanticElements": "off",
            "noNoninteractiveTabindex": "off",
            "useAriaPropsSupportedByRole": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
